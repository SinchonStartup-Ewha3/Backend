# Django values are examples only.
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgres://user:password@host:5432/database

# User-uploaded media (private S3; leave custom domain empty without CloudFront)
AWS_STORAGE_BUCKET_NAME=replace-me
AWS_S3_REGION_NAME=ap-northeast-2
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

# Paddle backend (Sandbox)
PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
PADDLE_PRICE_ID=pri_replace_me

# PayApp backend (never expose these values to frontend code)
PAYAPP_USER_ID=replace_me
PAYAPP_LINK_KEY=replace_me
PAYAPP_LINK_VALUE=replace_me
PAYAPP_REQUEST_KEY=replace_me
PAYAPP_FEEDBACK_URL=https://api.example.com/api/premium/webhooks/payapp/
# Leave blank until the frontend payment-result route exists.
PAYAPP_RETURN_URL=
# Optional: leave blank to use the seller settings.
PAYAPP_OPEN_PAY_TYPE=
PAYAPP_TIMEOUT_SECONDS=10

# Vite frontend variables belong in the frontend repository's .env file.
# VITE_PADDLE_CLIENT_TOKEN=test_replace_me
# VITE_PADDLE_ENVIRONMENT=sandbox
